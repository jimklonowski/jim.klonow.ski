# Every secret the Worker reads (grep server/ for process.env). Copy to .env for `pnpm dev`;
# in production each one is a Worker secret: `npx wrangler secret put <NAME>`.
# Values here are placeholders — never commit real ones (.env is gitignored, this file is NOT).

# HMAC key for the signed session / upload-PIN cookies (server/utils/auth.ts). Use >= 32 random
# bytes, e.g. `openssl rand -base64 32`. Rotating it signs everyone out, including you.
LABS_SECRET=

# Owner sign-in at /labs/login.
LABS_PASSWORD=

# Second factor for lab uploads (/labs/upload) — a 9-digit PIN by convention.
LABS_UPLOAD_PIN=

# Bearer token Health Auto Export sends to /api/journal/health-webhook. Its own secret, never a
# copy of LABS_SECRET; the webhook fails closed when this is unset.
WEBHOOK_TOKEN=

# Anthropic API key for lab-PDF parsing, lab summaries, digests, stock-dump parsing and /ask.
ANTHROPIC_API_KEY=

# Whoop OAuth app credentials (developer.whoop.com) for /api/whoop/* and the nightly sync.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
