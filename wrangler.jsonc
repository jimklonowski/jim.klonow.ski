{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jim-klonow-ski",
  "account_id": "82c809bb82b0eeaa8d0a77282865a43d",
  "compatibility_date": "2026-10-01",
  // The site lives only on jim.klonow.ski (a dashboard-attached custom domain). Without these,
  // wrangler re-enables the *.workers.dev twin on every deploy — a second, guessable origin
  // outside the zone's WAF and AI-crawler rules, serving the same static assets with no edge
  // protections. preview_urls covers version-preview subdomains the same way.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "main": "./.output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Both databases share one migrations folder, so the demo sandbox's schema can never fall
  // behind the real one (pnpm db:migrate applies to both; each keeps its own d1_migrations ledger).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jim-klonow-ski-db",
      "database_id": "03e6065f-e6e1-4a3d-ad03-d70d675a0bf3",
      "migrations_dir": "server/database/migrations"
    },
    {
      "binding": "DEMO_DB",
      "database_name": "jim-klonow-ski-demo",
      "database_id": "9e257a44-de08-4422-888d-f4d92e81f720",
      "migrations_dir": "server/database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LABS_BUCKET",
      "bucket_name": "jim-klonow-ski-labs"
    },
    {
      "binding": "PHOTOS_BUCKET",
      "bucket_name": "jim-klonow-ski-photos"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "96f29be3e5d34445af82db2b0bc21373"
    }
  ],
  // Workers Rate Limiting bindings (audit #43 item 47) — a counter that answers at once, in the
  // location the request hit, for the routes a stranger can call (server/utils/rateLimit.ts).
  // nuxt-security's KV limiter (routeRules in nuxt.config) keeps the longer windows, but KV is
  // eventually consistent, so a burst could run far past its count before the counters agreed.
  // The period can only be 10 or 60 seconds; namespace_id is any id unique within the Worker.
  "ratelimits": [
    {
      "name": "LIMIT_CREDENTIALS",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "LIMIT_PUBLIC",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "triggers": {
    "crons": [
      "0 9 * * *",
      "0 11 * * *",
      "0 14 * * *",
      "0 15 * * SUN",
      "0 8 * * SUN"
    ]
  }
}