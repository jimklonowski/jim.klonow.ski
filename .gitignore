# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# local mkcert TLS certs for the dev server (never commit — regenerate with: mkcert local.emkay.com)
certs/

# personal genome reports (never commit — repo is public; also served as static assets if left under public/)
public/sequencing.com/

# Machine-local shell setup (ssh-agent, nvm paths, a hardcoded key path). Belongs in ~/.bashrc:
# this is a public repo, and sourcing it is what makes `nvm` change identity mid-session.
.bashrc

# Claude Code's per-machine permission list — the "local" in the filename is the point.
.claude/settings.local.json

# Generated by `wrangler types` (see the postinstall script) from wrangler.jsonc AND .env, so its
# contents depend on the machine that ran it — it enumerates the secret NAMES found in .env.
# Tracking it meant a 15k-line diff on every regeneration and a stale file the rest of the time.
worker-configuration.d.ts

# lab / DEXA PDFs live in R2 and are served only through the authenticated /api/labs/pdf proxy.
# Anything under public/ ships as a Workers static asset that is answered BEFORE the Worker (and
# its auth middleware) runs — nine real reports sat here unauthenticated until 2026-09-21.
public/labs/
public/**/*.pdf
